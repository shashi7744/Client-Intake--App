# Copy this file to .env.local and fill in real values. DATABASE_URL is
# required - the app has no fallback data store anymore. Everything else
# can be left blank to keep running in mock mode (fake OTP "123456", fake
# payments).

# --- Database (Neon Postgres) - REQUIRED ---
# 1. Create a free project at https://neon.tech (a NEW project, not one you
#    already use for something else).
# 2. Click "Connect" on the project dashboard and copy the connection string.
# 3. Paste it below.
# 4. Run `node scripts/migrate.js` once to create the tables.
DATABASE_URL=

# --- Admin access ---
# There is no admin login/env credential anymore. Admin is just a role on a
# regular member account. Register normally at /register, then run:
#   node scripts/make-admin.js you@example.com
# to promote that account. It'll show extra "Members" and "All Complaints"
# sections in the same /dashboard after logging in normally.

# --- Razorpay (membership payments) ---
# Get these from https://dashboard.razorpay.com -> Settings -> API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Resend (email OTP: citizen login + member registration) ---
# Get this from https://resend.com -> API Keys. Free tier: 3,000 emails/mo,
# no credit card required. RESEND_FROM_EMAIL can stay as onboarding@resend.dev
# for testing - no domain setup needed to get started.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
